/*
===============================================================================
Stored Procedure: Load Bronze Layer (Source -> Bronze)
===============================================================================
Script Purpose:
    This stored procedure loads data into the 'bronze' schema from external CSV files. 
    It performs the following actions:
    - Truncates the bronze tables before loading data.
    - Uses the `BULK INSERT` command to load data from csv Files to bronze tables.

Parameters:
    None. 
	  This stored procedure does not accept any parameters or return any values.

Usage Example:
    EXEC bronze.load_bronze;
===============================================================================
*/

USE DataWarehouse;
GO

/*
-------------------------------------------------------------------------------
Loading the Datasets
-------------------------------------------------------------------------------
*/
CREATE OR ALTER PROCEDURE bronze.load_bronze AS
BEGIN
	DECLARE @start_time DATETIME, @end_time DATETIME, @batch_start_time DATETIME, @batch_end_time DATETIME; 
	BEGIN TRY
		SET @batch_start_time = GETDATE();
		PRINT '================================================';
		PRINT 'Loading Bronze Layer';
		PRINT '================================================';

		PRINT '------------------------------------------------';
		PRINT 'Loading Credit data, NPS Data, and Sales & Customer Tables';
		PRINT '------------------------------------------------';

/*
-------------------------------------------------------------------------------
Loading the Credit Data
-------------------------------------------------------------------------------
*/
		SET @start_time = GETDATE();
		PRINT '>> Truncating Table: bronze.credit_data';
		TRUNCATE TABLE bronze.credit_data;
		PRINT '>> Inserting Data Into: bronze.credit_data';
				BULK INSERT bronze.credit_data
		FROM 'C:\Users\Wanjiru\Documents\Annex_DE_Jacinta_Mukii\Data\abc_credit_data.csv'
		WITH (
			FIRSTROW = 2,
			FIELDTERMINATOR = ',',
			ROWTERMINATOR = '0x0a', -- Use hex for 'Line Feed' to avoid parsing issues
			TABLOCK
		); -- <--- Ensure this semicolon is here
		SET @end_time = GETDATE();
		PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS NVARCHAR) + ' seconds';
		PRINT '>> -------------';


/*
-------------------------------------------------------------------------------
Loading the NPS Data
-------------------------------------------------------------------------------
*/

		SET @start_time = GETDATE();
		PRINT '>> Truncating Table: bronze.NPS_data';
		TRUNCATE TABLE bronze.NPS_data;
		PRINT '>> Inserting Data Into: bronze.NPS_data';
		BULK INSERT bronze.NPS_data
		FROM 'C:\Users\Wanjiru\Documents\Annex_DE_Jacinta_Mukii\Data\abc_NPS_data.csv'
		WITH (
			FORMAT = 'CSV',
			FIRSTROW = 2,
			FIELDTERMINATOR = ',',
			ROWTERMINATOR = '\n',
			MAXERRORS = 100, -- Allows you to see more rows even if some fail
			TABLOCK
		);
		SET @end_time = GETDATE();
		PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS NVARCHAR) + ' seconds';
		PRINT '>> -------------';

/*
-------------------------------------------------------------------------------
Loading the Sales and Customer Data
-------------------------------------------------------------------------------
*/

		SET @start_time = GETDATE();
		PRINT '>> Truncating Table: bronze.sales_and_customer_data';
		TRUNCATE TABLE bronze.sales_and_customer_data;
		PRINT '>> Inserting Data Into: bronze.sales_and_customer_data';
		BULK INSERT bronze.sales_and_customer_data
		FROM 'C:\Users\Wanjiru\Documents\Annex_DE_Jacinta_Mukii\Data\abc_Sales_and_Customer_data.csv'
		WITH (
			FORMAT = 'CSV',
			FIRSTROW = 2,
			FIELDTERMINATOR = ',',
			ROWTERMINATOR = '\n',
			MAXERRORS = 100, -- Allows you to see more rows even if some fail
			TABLOCK
		);
		SET @end_time = GETDATE();
		PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS NVARCHAR) + ' seconds';
		PRINT '>> -------------';

	END TRY
	BEGIN CATCH
		PRINT 'Error occurred during loading';
		PRINT ERROR_MESSAGE();
	END CATCH
END;
GO

